{
  "name": "solexpay-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.70.0",
    "@tanstack/react-query": "5.107.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "tailwindcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "msw": "3.0.4",
    "vitest": "5.1.0",
    "@vitejs/plugin-react": "6.2.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "31.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
