{
  "name": "solexpay-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "rm -f out/mockServiceWorker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "worker:dev": "bun run build && wrangler dev",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "worker:test": "vitest run --config worker/vitest.config.mts",
    "deploy:staging": "bun run build && wrangler deploy --env staging",
    "deploy:production": "bun run build && wrangler deploy --env production",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "6.0.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.22",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "jose": "6.2.13",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "nuqs": "2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "5.20261024.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "msw": "3.0.4",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.155.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver",
    "workerd"
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
