{
  // Set SESSION_KEY and GATEWAY_SECRET with `wrangler secret put --env <env>`.
  "name": "solexpay-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "development",
    "API_ORIGIN": "http://127.0.0.1:8080"
  },
  "env": {
    "staging": {
      "name": "solexpay-admin-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "API_ORIGIN": "https://staging-api.solexpay.com.ng",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "ratelimits": [
        {
          "name": "LOGIN_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "API_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "routes": []
    },
    "production": {
      "name": "solexpay-admin",
      "vars": {
        "ENVIRONMENT": "production",
        "API_ORIGIN": "https://api.solexpay.com.ng",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "ratelimits": [
        {
          "name": "LOGIN_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "API_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 300, "period": 60 }
        }
      ],
      "routes": []
    }
  }
}
